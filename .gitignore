# Generated integration files — run 'mise run convert' to regenerate locally.
# The converter writes one directory per agent: integrations/<tool>/<slug>/.
# The integrations/*/README.md files ARE committed; generated dirs are not.
integrations/*/*/
integrations/aider/CONVENTIONS.md
integrations/windsurf/.windsurfrules
integrations/gemini-cli/gemini-extension.json
